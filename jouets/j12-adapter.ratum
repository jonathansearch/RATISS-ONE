# j12 — adapter : le seuil rejoint la charge à mi-chemin
# 50 + charge 100 -> 75, puis 75 + charge 0 -> 37.
tissu SeuilsVivants
  neurone a seuil 50
  neurone b seuil 50
  lien a b force 10
  motif M : a b
  dire naissance : seuils
  rencontre M
  adapter
  dire après le feu : seuils
  repos
  adapter
  dire après le calme : seuils
fin
