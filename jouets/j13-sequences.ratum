# j13 — la trace de l'ordre : liens tissés, la suite renforce ; avec repos entre, ça retombe
tissu Suite
  neurone a seuil 50
  neurone b seuil 50
  neurone c seuil 50
  neurone d seuil 50
  neurone e seuil 50
  lien a b force 50
  lien b c force 50
  lien d e force 50
  motif A : a
  motif B : b
  motif C : c
  motif D : d
  motif E : e
  # sans repos entre les rencontres : les voisins se lient
  rencontre A
  rencontre B
  propager
  renforcer
  repos
  rencontre B
  rencontre C
  propager
  renforcer
  repos
  dire chaîne liée : forces
  # avec repos entre : même la force 50 retombe
  rencontre D
  repos
  rencontre E
  propager
  renforcer
  repos
  dire chaîne déliée : forces
fin
