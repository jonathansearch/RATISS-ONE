# j14 — l'étincelle CISE : trop lent = rien, hyper-vitesse = figé pour toujours
# vitesse = battements + énergie en mains de 20 ; à 10 alors qu'il bat : collision !
# Le filament (lien gelé, marqué !) survit aux nuits et à la faucheuse.
tissu Etincelle
  neurone a seuil 50
  neurone b seuil 50
  neurone c seuil 50
  neurone d seuil 50
  lien a b force 10
  lien c d force 10
  motif M : a b
  # pas assez vite : 4 rencontres chaudes (vitesse 4+5=9), le cise rate
  répéter 3
    rencontre M
    propager
    renforcer
    repos
  fin
  rencontre M
  propager
  renforcer
  cise M
  repos
  dire trop tôt : forces
  # assez vite : 11 battements à chaud (vitesse 11+5=16), ça explose !
  répéter 6
    rencontre M
    propager
    renforcer
    repos
  fin
  rencontre M
  propager
  renforcer
  cise M
  repos
  dire étincelle : forces
  mesurer
  # la faucheuse passe : le lien mort c-d est arraché, le filament reste
  nettoyer
  dire après faucheuse : forces
  # 20 nuits : le gelé ne bouge pas d'un poil
  répéter 20
    oublier
  fin
  dire après 20 nuits : forces
  juger M 60
fin
