# ============================================================
# RNI INTERFÉRENCE — deux formes sans rien en commun
# RATISS Labs · langage Ratum v0 · programme 100 % Ratum
#
# Leçon : quand deux formes ne partagent AUCUN nœud, apprendre
# la seconde EFFACE la première. C'est le prix de la loi pure :
# sans répétition commune, le nouveau chasse l'ancien.
# ============================================================

tissu Oubli

  neurone x seuil 50
  neurone y seuil 50
  neurone p seuil 50
  neurone q seuil 50

  lien x y force 10
  lien p q force 10

  motif PREMIER : x y
  motif SECOND : p q

  dire === on apprend le PREMIER (6 fois) ===
  répéter 6
    rencontre PREMIER
    propager
    renforcer
    repos
  fin
  dire PREMIER tient à résonance PREMIER sur 100
  juger PREMIER 60

  dire === on apprend le SECOND (6 fois), sans revoir le premier ===
  répéter 6
    rencontre SECOND
    propager
    renforcer
    repos
  fin
  dire PREMIER tient à résonance PREMIER sur 100
  dire SECOND tient à résonance SECOND sur 100
  juger PREMIER 60
  juger SECOND 60

  si PREMIER tient 60 alors
    dire le premier souvenir a résisté
  sinon
    dire leçon confirmée : le nouveau a chassé l ancien
  fin

fin
