# ============================================================
# RNI SIMPLIFIÉ — trois neurones apprennent à battre ensemble
# RATISS Labs · langage Ratum v0 · programme 100 % Ratum
# Leçon : la répétition creuse le chemin (rencontres → liens forts)
# ============================================================

tissu Eveil

  # --- les habitants : 4 neurones, seuil 50 ---
  neurone a seuil 50
  neurone b seuil 50
  neurone c seuil 50
  neurone d seuil 50

  # --- les liens naissent faibles (force 10) ---
  lien a b force 10
  lien b c force 10
  lien a c force 10

  # --- les formes : une apprise, une étrangère ---
  motif ABC : a b c
  motif ETRANGER : c d

  dire --- avant les rencontres ---
  dire la forme ABC tient à résonance ABC sur 100
  juger ABC 60

  # --- le cœur minimal : rencontre → propagation → loi → repos ---
  répéter 5
    rencontre ABC
    propager
    renforcer
    repos
  fin

  dire --- après 5 rencontres ---
  dire la forme ABC tient à résonance ABC sur 100
  juger ABC 60
  juger ETRANGER 60
  mesurer

fin
